#!/bin/zsh
#
# quad-iterm — quad 的 iTerm2 版：開四個新的 iTerm2 視窗排成內建螢幕的四宮格，每格跑 claude。
#
#   quad-iterm                    預設帳號（~/.claude）
#   quad-iterm --account=peter    帳號清單上的帳號（rakucamp · Max 20×）
#   quad-iterm --dir=<資料夾>      每格 cd 到哪（預設目前目錄）
#   quad-iterm --dry              只印座標與指令
#
# 為什麼要 iTerm2 版：session-remote（手機遙控）只看得到、也只送得進 iTerm2 分頁；
# Terminal.app 送字一定會搶畫面。
#
# 跟 Terminal 版一樣的鐵則：**不碰任何既有視窗**，只開新的。
# 座標算法沿用 quad 的 geometry()（NSScreen 左下原點 → AppleScript 左上原點）。
# 帳號讀同一份帳號清單（home/claude/accounts/<LocalHostName>.json）。
set -euo pipefail

ACCOUNT_ID=""; DIR=$PWD; DRY=0
for arg in "$@"; do
  case $arg in
    --account=*) ACCOUNT_ID=${arg#--account=} ;;
    --20x) ACCOUNT_ID=peter ;;
    --dir=*) DIR=${arg#--dir=} ;;
    --dry) DRY=1 ;;
    -h|--help) sed -n '3,12p' "$0"; exit 0 ;;
    *) print -u2 "不認得的參數：$arg"; exit 2 ;;
  esac
done

ACCOUNTS="$HOME/.claude/skills/home/claude/accounts/$(scutil --get LocalHostName).json"
if [[ -n $ACCOUNT_ID ]]; then
  CONFIG_DIR=$(jq -r --arg id "$ACCOUNT_ID" '.accounts[] | select(.id==$id or ((.aliases // []) | index($id))) | .config_dir' "$ACCOUNTS" | head -1)
  [[ -n $CONFIG_DIR ]] || { print -u2 "帳號清單裡沒有 $ACCOUNT_ID"; exit 2; }
  CONFIG_DIR=${CONFIG_DIR/#\~/$HOME}
else
  CONFIG_DIR="$HOME/.claude"
fi
PROFILE=$(jq -r --arg d "${CONFIG_DIR/#$HOME/~}" '.accounts[] | select(.config_dir==$d) | .colors.work_profile // ""' "$ACCOUNTS" | head -1)
# Terminal 設定檔名 → iTerm2 的底色（iTerm2 沒有同名設定檔，直接設 session 底色）
case $PROFILE in
  "Red Sands") BG="{31354, 9509, 4883}" ;;    # #7A2513
  "Ocean")     BG="{8738, 20046, 48573}" ;;   # #224EBD
  *)           BG="" ;;
esac

# 預設帳號也要明講：iTerm2 若是從帶著 CLAUDE_CONFIG_DIR 的程序開的，新 shell 會繼承它
if [[ $CONFIG_DIR == "$HOME/.claude" ]]; then
  RUN="env -u CLAUDE_CONFIG_DIR claude"
else
  RUN="CLAUDE_CONFIG_DIR=${(qq)CONFIG_DIR} claude"
fi
CMD="cd ${(qq)DIR} && $RUN"
# 測試用：QUAD_ITERM_CMD 換掉每格要跑的指令（例如 echo），不真的開四個 claude
[[ -n ${QUAD_ITERM_CMD:-} ]] && CMD=$QUAD_ITERM_CMD

GEOM=$(osascript -l JavaScript <<'JXA'
ObjC.import('AppKit');
const screens = ObjC.unwrap($.NSScreen.screens);
const H0 = screens[0].frame.size.height;
let target = screens.find((s) => /built-?in|color lcd|liquid retina/i.test(ObjC.unwrap(s.localizedName)));
if (!target) target = screens[0];
const vf = target.visibleFrame;
const left = vf.origin.x, right = vf.origin.x + vf.size.width;
const top = H0 - (vf.origin.y + vf.size.height), bottom = H0 - vf.origin.y;
const midX = Math.round(left + (right - left) / 2), midY = Math.round(top + (bottom - top) / 2);
const L = Math.round(left), R = Math.round(right), T = Math.round(top), B = Math.round(bottom);
[[L, T, midX, midY], [midX, T, R, midY], [L, midY, midX, B], [midX, midY, R, B]].map((q) => q.join(', ')).join('\n');
JXA
)

if (( DRY )); then
  print "指令：$CMD"; print "底色：${BG:-（預設）}"; print "$GEOM"; exit 0
fi

# iTerm2 沒開就在背景開（不搶畫面），等它能回應 AppleScript
if ! pgrep -x iTerm2 >/dev/null; then
  "$HOME/.claude/skills/home/claude/tools/bgrun" /Applications/iTerm.app/Contents/MacOS/iTerm2 >/dev/null 2>&1 &!
  for i in {1..30}; do pgrep -x iTerm2 >/dev/null && break; sleep 0.5; done
  sleep 2
fi

for bounds in ${(f)GEOM}; do
  osascript - "$CMD" "{$bounds}" "$BG" <<'OSA' >/dev/null
on run argv
  tell application "iTerm2"
    set w to (create window with default profile)
    set bounds of w to (run script (item 2 of argv))
    set s to current session of w
    if (item 3 of argv) is not "" then set background color of s to (run script (item 3 of argv))
    tell s to write text (item 1 of argv)
  end tell
end run
OSA
done
print "iTerm2 四格開好了（$([[ -n $ACCOUNT_ID ]] && print $ACCOUNT_ID || print 預設帳號)）"
