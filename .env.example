# 這個檔進版控，.env 不進。
#
# 埠位不是祕密，寫實際值——clone 下來直接 cp .env.example .env 就能跑。
# 真的有金鑰的時候才在這裡留空白佔位。

WEB_PORT=5390
API_PORT=5391
# 0.0.0.0：手機從 Tailscale 連進來（服務本身只放行本機與 100.64.0.0/10）
HOST=0.0.0.0

# 手機連線用的通行碼。產生：python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
SESSION_REMOTE_TOKEN=

# Apple 推播金鑰（開發者後台 → Keys → Apple Push Notifications service）。沒填就不推播。
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=CXJ2S2G4JD
APNS_BUNDLE_ID=com.bruuucechang.sessionremote
